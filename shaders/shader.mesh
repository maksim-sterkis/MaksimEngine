#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

// Inputs from Task Shader
struct TaskData {
    uint meshletIndices[32];
};
taskPayloadSharedEXT TaskData IN;

struct Vertex {
    float px, py, pz;
    float cx, cy, cz;
    float nx, ny, nz;
    float tx, ty;
};

struct Meshlet {
    uint vertexOffset;
    uint triangleOffset;
    uint vertexCount;
    uint triangleCount;
};

layout(scalar, set = 0, binding = 0) readonly buffer Meshlets {
    Meshlet meshlets[];
};

layout(scalar, set = 0, binding = 1) readonly buffer MeshletVertices {
    uint meshletVertices[];
};

layout(scalar, set = 0, binding = 2) readonly buffer MeshletTriangles {
    uint8_t meshletTriangles[];
};

layout(scalar, set = 0, binding = 3) readonly buffer MeshletBounds {
    vec4 bounds[];
};

layout(scalar, set = 0, binding = 4) readonly buffer VertexBuffer {
    Vertex vertices[];
};

// Push constants for model matrix and material
layout(push_constant) uniform PushConstants {
    mat4 mvp;
    mat4 cull_mvp;
    vec4 cull_local_camera_pos;
    vec4 colorOverride;
    int useOverride;
    int useTriplanar;
    int hasTexture;
    int debugColors;
    uint materialIndex;
    uint meshletCount;
} push;

layout(scalar, set = 2, binding = 2) buffer StatsBuffer {
    uint taskInvocations;
    uint meshInvocations;
} stats;

// Outputs to Fragment Shader
layout(location = 0) out vec3 outColor[];
layout(location = 1) out vec2 outTexCoord[];
layout(location = 2) out flat uint outMaterialIndex[];

void main() {
    uint meshletIndex = IN.meshletIndices[gl_WorkGroupID.x];
    Meshlet m = meshlets[meshletIndex];

    if (gl_LocalInvocationID.x == 0) {
        atomicAdd(stats.meshInvocations, 1);
    }

    SetMeshOutputsEXT(m.vertexCount, m.triangleCount);

    // Process vertices
    for (uint i = gl_LocalInvocationID.x; i < m.vertexCount; i += 32) {
        uint vertexIndex = meshletVertices[m.vertexOffset + i];
        Vertex v = vertices[vertexIndex];

        vec4 worldPos = vec4(v.px, v.py, v.pz, 1.0);
        gl_MeshVerticesEXT[i].gl_Position = push.mvp * worldPos;

        if (push.debugColors == 1) {
            uint h = (meshletIndex ^ 61) ^ (meshletIndex >> 16);
            h = h + (h << 3);
            h = h ^ (h >> 4);
            h = h * 0x27d4eb2d;
            h = h ^ (h >> 15);
            vec3 col = vec3(
                float((h >>  0) & 0xFF) / 255.0,
                float((h >>  8) & 0xFF) / 255.0,
                float((h >> 16) & 0xFF) / 255.0
            );
            // Prevent completely dark colors so meshlets don't look unrendered
            outColor[i] = mix(col, vec3(1.0), 0.3);
        } else {
            outColor[i] = vec3(v.cx, v.cy, v.cz);
        }
        outTexCoord[i] = vec2(v.tx, v.ty);
        outMaterialIndex[i] = push.materialIndex;
    }

    // Process triangles
    for (uint i = gl_LocalInvocationID.x; i < m.triangleCount; i += 32) {
        uint triOffset = m.triangleOffset + i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            meshletTriangles[triOffset + 0],
            meshletTriangles[triOffset + 1],
            meshletTriangles[triOffset + 2]
        );
    }
}
