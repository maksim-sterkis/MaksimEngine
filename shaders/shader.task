#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

struct TaskData {
    uint meshletIndices[32];
};
taskPayloadSharedEXT TaskData OUT;

layout(push_constant) uniform PushConstants {
    mat4 mvp;
    vec4 colorOverride;
    int useOverride;
    int useTriplanar;
    int hasTexture;
    int debugColors;
    uint materialIndex;
    uint meshletCount;
} push;

void main() {
    uint meshletIndex = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x;
    
    // Write valid meshlet index or an invalid sentinel value (e.g. 0xFFFFFFFF)
    if (meshletIndex < push.meshletCount) {
        OUT.meshletIndices[gl_LocalInvocationID.x] = meshletIndex;
    } else {
        OUT.meshletIndices[gl_LocalInvocationID.x] = 0xFFFFFFFF;
    }
    
    barrier();
    
    if (gl_LocalInvocationID.x == 0) {
        // Calculate how many meshlets are valid in this task workgroup
        uint validCount = 0;
        for (uint i = 0; i < 32; i++) {
            if (OUT.meshletIndices[i] != 0xFFFFFFFF) {
                validCount++;
            }
        }
        
        // Emit only the valid number of mesh workgroups
        EmitMeshTasksEXT(validCount, 1, 1);
    }
}
